# ==============================================================================
# MULTIMEDIA IN ACTION 2026 - FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# API Base URL (Pointing to Backend Express API)
NEXT_PUBLIC_API_URL="https://api.multimediainaction.id/api/v1"

# Production Canonical Site URL (Used for Open Graph, Sitemap & Robots)
NEXT_PUBLIC_SITE_URL="https://multimediainaction.id"

# JWT Secret (Must match Backend JWT_SECRET for client session/cookie decoding)
JWT_SECRET="generate_a_very_long_secure_random_string_here"

# Web Analytics (Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=""

# Optional Integration Tokens
FIGMA_ACCESS_TOKEN=""

# Emergency Maintenance Mode Configuration
# Set to "true" to lock public access and show the official maintenance page
NEXT_PUBLIC_MAINTENANCE_MODE="false"

# Secret bypass token for committee/dev access during maintenance (Access via: /?bypass_maintenance=TOKEN)
MAINTENANCE_BYPASS_TOKEN="mia2026_dev_bypass"
